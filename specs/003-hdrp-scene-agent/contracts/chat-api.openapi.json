{
  "openapi": "3.1.0",
  "info": {
    "title": "UnityMapper chat application \u2014 planned contract",
    "version": "0.1.0",
    "description": "Design only. Local Go server; Python provider token and financial ledger remain server-side."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "security": [
    {
      "localSession": []
    }
  ],
