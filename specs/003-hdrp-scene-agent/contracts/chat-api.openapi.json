              }
            }
          },
          "default": {
            "description": "Typed error; unknown execution is not retryable automatically",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": []
